# ==========================================
# RedLocalBlock - Configuración de Entorno
# ==========================================

# Nivel de registro (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Intervalo entre ráfagas de paquetes ARP (en segundos)
ARP_SPOOF_INTERVAL=2.0

# Número de paquetes legítimos a emitir en la reconciliación
ARP_RESTORE_COUNT=5

# Timeout para escaneo de red por broadcast ARP (en segundos)
SCAN_TIMEOUT=2.5

# Modo de tema por defecto (dark, light, system)
UI_THEME=dark
